# Copy to .env and fill in what you need. Every value is optional:
# without provider keys, use the ollama profile and the local-chat model.

# Provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The admin token (at least 32 characters) and the static key clients use.
GATEWAY_ADMIN_TOKEN=local-admin-token-change-me-0000000000
GATEWAY_DEV_KEY=gog-local-dev-key

# The model the ollama profile downloads and serves as local-chat.
OLLAMA_MODEL=qwen2.5:0.5b

# Uncomment with the observability profile to send traces to Jaeger.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# The host port for the gateway.
GATEWAY_PORT=8080
